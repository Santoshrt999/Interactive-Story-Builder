# StoryWeaver backend configuration.
# All keys are OPTIONAL. With no keys present the app runs with deterministic
# canned fallbacks (story text), placeholder SVG images, and no-op voice.

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=

REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite+aiosqlite:///./storyweaver.db

PARENT_DASHBOARD_SECRET=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
